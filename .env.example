# Bagian dari SECTORS_CREDIT_BUDGET yang boleh dipakai analisis publik (default 0.7).
# Sisanya dicadangkan untuk pnpm seed:history dan rekaman demo.
PUBLIC_ANALYSIS_BUDGET_RATIO=0.7
FAKE_SHOCK_DAY=
